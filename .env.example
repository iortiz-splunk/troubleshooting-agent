# See shared/README.md for full variable descriptions.
#
# Workshop EC2 instances export LLM, Splunk MCP, OTel, and Galileo API credentials
# as environment variables. You do not need to duplicate those in .env — the agent
# reads shell env vars and merges them with this file (shell env wins on conflict).
#
# In .env, set at minimum:
#   ENABLE_GALILEO=true
#   GALILEO_PROJECT=workshop-<your-instance>
#   GALILEO_LOG_STREAM=part1-<your-instance>
#
# LLM provider (optional): ollama | openai | azure_openai
# If unset, uses openai when OPENAI_API_KEY + OPENAI_BASE_URL are set; otherwise ollama.
# LLM_PROVIDER=openai

# Ollama (default LLM provider)
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen2.5-coder:7b
# LLM_TEMPERATURE=0.2
# OLLAMA_TEMPERATURE=0.2   # alias for LLM_TEMPERATURE

# OpenAI-compatible API — provided on workshop EC2 (do not add placeholder values here)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_NAME=gpt-4.1-mini

# Azure OpenAI native client (when LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21

# Splunk MCP — see shared/README.md (mcp-doctor, then chat)
#
# Splunk Observability Cloud (o11y tools on Splunk MCP server)
# Auth: X-SF-REALM + X-SF-TOKEN only (not Splunk Cloud Bearer below)
# Use the same MCP server host as SPLUNK_CLOUD_MCP_URL (mcp-*.stg.splunkcloud.com).
# Legacy region-*.api.scs.splunk.com values are auto-replaced when Cloud MCP URL is set.
# ENABLE_SPLUNK_O11Y=true
# SPLUNK_O11Y_GATEWAY_URL=https://mcp-<instance>.stg.splunkcloud.com:8089/services/mcp
# SPLUNK_O11Y_REALM=us1
# SPLUNK_O11Y_API_TOKEN=your-observability-api-token
# SPLUNK_O11Y_TOOL_PREFIX=o11y_
# Default APM environment when alert/metadata omit sf_environment (optional)
# SPLUNK_O11Y_ENVIRONMENT=sre-agent-workshop
# Default Splunk index for log search when not in alert context (optional)
# SPLUNK_SEARCH_INDEX=splunk4rookies-workshop

# Splunk Cloud MCP server (platform / logs — Bearer + tenant, not o11y-only auth)
# Host-only is OK — the agent appends :8089/services/mcp when missing.
# ENABLE_SPLUNK_CLOUD_MCP=true
# SPLUNK_CLOUD_MCP_URL=https://mcp-<instance>.stg.splunkcloud.com:8089/services/mcp
# SPLUNK_CLOUD_MCP_BEARER_TOKEN=your-splunk-cloud-mcp-jwt
# SPLUNK_CLOUD_MCP_TENANT=your-splunk-tenant-name

# Splunk Enterprise MCP (on-prem)
# ENABLE_SPLUNK_MCP=true
# SPLUNK_MCP_URL=https://your-splunk-host:8089/services/mcp
# SPLUNK_MCP_BEARER_TOKEN=your-bearer-token

# MCP transport command (default: npx)
# MCP_NPX_COMMAND=npx

# TLS for mcp-remote (Node.js) — staging / self-signed Splunk Cloud hosts only
# Prefer MCP_TLS_CA_CERTS with your CA bundle; use MCP_TLS_INSECURE as a temporary workaround.
# MCP_TLS_INSECURE=true
# MCP_TLS_CA_CERTS=/path/to/splunk-staging-ca.pem

# Slack demo — see shared/README.md
# ENABLE_SLACK=true
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...
# SLACK_ALERTS_CHANNEL_NAME=splunk-observability-alerts-1
# SLACK_ALERTS_CHANNEL_ID=        # optional; use if name lookup fails

# Agent logging trace (terminal + JSONL files)
# AGENT_LOG_TRACE=true
# AGENT_LOG_DEBUG=false
# AGENT_LOG_DIR=shared/logs/investigations
# LOG_FORMAT=text

# Agent OTel — export traces/metrics to a local OpenTelemetry Collector (OTLP/HTTP)
# The collector routes data to Splunk Observability Cloud; no ingest token on the agent.
# ENABLE_SPLUNK_OTEL=true
# OTEL_SERVICE_NAME=troubleshooting-agent
# OTEL_COLLECTOR_ENDPOINT=http://localhost:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=demo

# Galileo agent observability
# ENABLE_GALILEO=true
# GALILEO_API_KEY=
# GALILEO_CONSOLE_URL=https://app.galileo.ai   # required; use your tenant console URL
# GALILEO_PROJECT=troubleshooting-agent
# GALILEO_LOG_STREAM=slack-investigations
#GALILEO_CONSOLE_URL="https://console.multitenant.galileocloud.io"
